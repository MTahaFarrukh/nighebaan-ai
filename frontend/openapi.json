{
  "openapi": "3.1.0",
  "info": {
    "title": "Nigehbaan AI",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Return a simple liveness payload.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyze/text": {
      "post": {
        "tags": [
          "analyze"
        ],
        "summary": "Analyze Text",
        "description": "Analyze a free-text message for scam / abuse signals.",
        "operationId": "analyze_text_api_analyze_text_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TextAnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyze/url": {
      "post": {
        "tags": [
          "analyze"
        ],
        "summary": "Analyze Url",
        "description": "Analyze a URL with the trained static model, without fetching its target.",
        "operationId": "analyze_url_api_analyze_url_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UrlAnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyze/file": {
      "post": {
        "tags": [
          "analyze"
        ],
        "summary": "Analyze File",
        "description": "Close framework spool files on every success/failure path.",
        "operationId": "analyze_file_api_analyze_file_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_file_api_analyze_file_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileAnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics/models": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Model Metrics",
        "description": "Expose aggregate measured metrics, excluding paths and artifact metadata.",
        "operationId": "model_metrics_api_metrics_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelMetrics"
                }
              }
            }
          }
        }
      }
    },
    "/api/alerts": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Alerts",
        "description": "High-risk web analysis history, not sent WhatsApp notifications.",
        "operationId": "alerts_api_alerts_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertHistory"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Public Settings",
        "description": "Return display-only thresholds; never return environment secrets.",
        "operationId": "public_settings_api_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicSettings"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "description": "Root welcome payload.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Root  Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Ablation": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/ModelMetric"
            },
            "type": "array",
            "title": "Rows"
          }
        },
        "type": "object",
        "required": [
          "name",
          "rows"
        ],
        "title": "Ablation"
      },
      "AlertHistory": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AlertRow"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "by_modality": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "By Modality"
          },
          "by_day": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "By Day"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset",
          "by_modality",
          "by_day"
        ],
        "title": "AlertHistory"
      },
      "AlertRow": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "ts": {
            "type": "string",
            "title": "Ts"
          },
          "modality": {
            "type": "string",
            "title": "Modality"
          },
          "label": {
            "type": "string",
            "enum": [
              "normal",
              "abusive",
              "scam"
            ],
            "title": "Label"
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Risk Level"
          },
          "risk_score": {
            "type": "number",
            "title": "Risk Score"
          },
          "rule_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rule Ids"
          }
        },
        "type": "object",
        "required": [
          "id",
          "ts",
          "modality",
          "label",
          "risk_level",
          "risk_score",
          "rule_ids"
        ],
        "title": "AlertRow"
      },
      "AnalyzeResponse": {
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "normal",
              "abusive",
              "scam"
            ],
            "title": "Label"
          },
          "probabilities": {
            "$ref": "#/components/schemas/Probabilities"
          },
          "rule_flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rule Flags"
          },
          "risk_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Risk Score"
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Risk Level"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "flagged_words": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Flagged Words"
          },
          "url_features": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url Features"
          }
        },
        "type": "object",
        "required": [
          "label",
          "probabilities",
          "rule_flags",
          "risk_score",
          "risk_level",
          "explanation",
          "flagged_words"
        ],
        "title": "AnalyzeResponse",
        "description": "Shared response shape for text and URL analysis."
      },
      "Body_analyze_file_api_analyze_file_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_analyze_file_api_analyze_file_post"
      },
      "ClassMetric": {
        "properties": {
          "p": {
            "type": "number",
            "title": "P"
          },
          "r": {
            "type": "number",
            "title": "R"
          },
          "f1": {
            "type": "number",
            "title": "F1"
          }
        },
        "type": "object",
        "required": [
          "p",
          "r",
          "f1"
        ],
        "title": "ClassMetric"
      },
      "FileAnalyzeResponse": {
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "normal",
              "abusive",
              "scam"
            ],
            "title": "Label"
          },
          "probabilities": {
            "$ref": "#/components/schemas/Probabilities"
          },
          "rule_flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rule Flags"
          },
          "risk_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Risk Score"
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Risk Level"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "flagged_words": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Flagged Words"
          },
          "url_features": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url Features"
          },
          "modality": {
            "type": "string",
            "enum": [
              "image",
              "pdf",
              "audio",
              "video"
            ],
            "title": "Modality"
          },
          "extracted_text": {
            "type": "string",
            "title": "Extracted Text"
          },
          "extraction_confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extraction Confidence"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "label",
          "probabilities",
          "rule_flags",
          "risk_score",
          "risk_level",
          "explanation",
          "flagged_words",
          "modality",
          "extracted_text"
        ],
        "title": "FileAnalyzeResponse",
        "description": "In-memory preview only; extraction content is never persisted."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelMetric": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "macro_f1": {
            "type": "number",
            "title": "Macro F1"
          },
          "accuracy": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accuracy"
          },
          "per_class": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ClassMetric"
            },
            "type": "object",
            "title": "Per Class"
          },
          "confusion_matrix": {
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Confusion Matrix"
          }
        },
        "type": "object",
        "required": [
          "name",
          "macro_f1"
        ],
        "title": "ModelMetric"
      },
      "ModelMetrics": {
        "properties": {
          "evaluation_split": {
            "type": "string",
            "title": "Evaluation Split"
          },
          "data_review_status": {
            "type": "string",
            "title": "Data Review Status"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelMetric"
            },
            "type": "array",
            "title": "Models"
          },
          "best_model": {
            "type": "string",
            "title": "Best Model"
          },
          "url_models": {
            "items": {
              "$ref": "#/components/schemas/ModelMetric"
            },
            "type": "array",
            "title": "Url Models"
          },
          "best_url_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Best Url Model"
          },
          "ablations": {
            "items": {
              "$ref": "#/components/schemas/Ablation"
            },
            "type": "array",
            "title": "Ablations"
          }
        },
        "type": "object",
        "required": [
          "evaluation_split",
          "data_review_status",
          "models",
          "best_model"
        ],
        "title": "ModelMetrics"
      },
      "Probabilities": {
        "properties": {
          "normal": {
            "type": "number",
            "title": "Normal"
          },
          "abusive": {
            "type": "number",
            "title": "Abusive"
          },
          "scam": {
            "type": "number",
            "title": "Scam"
          }
        },
        "type": "object",
        "required": [
          "normal",
          "abusive",
          "scam"
        ],
        "title": "Probabilities",
        "description": "Class probability scores from the (stub) classifier."
      },
      "PublicSettings": {
        "properties": {
          "medium_threshold": {
            "type": "number",
            "title": "Medium Threshold"
          },
          "high_threshold": {
            "type": "number",
            "title": "High Threshold"
          },
          "credential_url_floor": {
            "type": "number",
            "title": "Credential Url Floor"
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run"
          },
          "whatsapp_available": {
            "type": "boolean",
            "title": "Whatsapp Available",
            "default": false
          },
          "consent_available": {
            "type": "boolean",
            "title": "Consent Available",
            "default": false
          },
          "max_upload_mb": {
            "type": "integer",
            "title": "Max Upload Mb",
            "default": 25
          },
          "max_pdf_pages": {
            "type": "integer",
            "title": "Max Pdf Pages",
            "default": 20
          },
          "max_media_seconds": {
            "type": "integer",
            "title": "Max Media Seconds",
            "default": 60
          }
        },
        "type": "object",
        "required": [
          "medium_threshold",
          "high_threshold",
          "credential_url_floor",
          "dry_run"
        ],
        "title": "PublicSettings"
      },
      "TextAnalyzeRequest": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text",
            "description": "Message text to analyze"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TextAnalyzeRequest",
        "description": "Request body for text analysis."
      },
      "UrlAnalyzeRequest": {
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "title": "Url",
            "description": "URL to analyze"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "UrlAnalyzeRequest",
        "description": "Request body for URL analysis."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}